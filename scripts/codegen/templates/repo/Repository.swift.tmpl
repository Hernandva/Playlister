import Foundation

/// Public API of the {{Repo}} repository. Features depend on this protocol, never on the concrete class.
public protocol {{Repo}}RepositoryProtocol: Sendable {
    /// Calls one of the services in `{{Repo}}Repository.configuration.serviceNames`.
    func fetch(_ request: some {{Repo}}RequestProtocol, serviceName: String) async throws -> any {{Repo}}ResponseProtocol
}

/// Talks to the {{Repo}} services.
/// Flow: {{Repo}}RequestProtocol -> {{Repo}}RequestDAO -> {{Repo}}ResponseDAO -> {{Repo}}ResponseProtocol.
public final class {{Repo}}Repository: {{Repo}}RepositoryProtocol {
    /// Fill in the base URL and the names of the services this repository consumes.
    public static let configuration = RepositoryConfiguration(
        baseURL: "",
        serviceNames: []
    )

    private let client: NetworkClient
    private let configuration: RepositoryConfiguration

    public init(
        client: NetworkClient = .shared,
        configuration: RepositoryConfiguration = {{Repo}}Repository.configuration
    ) {
        self.client = client
        self.configuration = configuration
    }

    public func fetch(_ request: some {{Repo}}RequestProtocol, serviceName: String) async throws -> any {{Repo}}ResponseProtocol {
        let url = try configuration.url(for: serviceName)
        let requestDAO = {{Repo}}RequestDAO(request)
        let responseDAO: {{Repo}}ResponseDAO = try await client.request(url, method: .get, body: requestDAO)
        return responseDAO
    }
}
