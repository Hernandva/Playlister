    "home.settingsSheet.message %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Playlister doesn't have access to %@. Open Playlister's settings and allow it to connect your account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Playlister no tiene acceso a %@. Abre los ajustes de Playlister y dale permiso para conectar tu cuenta."
          }
        }
      }
    },
