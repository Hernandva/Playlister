    },
    "home.loginError.notAuthorized %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Playlister doesn't have access to %@. Allow it in Playlister's settings and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Playlister no tiene acceso a %@. Dale permiso en los ajustes de Playlister y vuelve a intentarlo."
          }
        }
      }
    },
    "home.loginError.subscriptionRequired %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You need an active %@ subscription to play music in Playlister."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necesitas una suscripción activa a %@ para reproducir música en Playlister."
          }
        }
      }
    },
